# Public ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://trymoveasy.vercel.app

# WhatsApp community — surfaced in the success toast right after a fresh
# signup so people can jump into the group. Leave blank to disable.
NEXT_PUBLIC_WA_COMMUNITY_URL=
NEXT_PUBLIC_WAITLIST_BASELINE=128

# Supabase --------------------------------------------------------------------
# Either key works for inserts (publishable + RLS policy, OR service role).
# Service role is required for the live signup counter to climb.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend ----------------------------------------------------------------------
# Confirmation email after a successful waitlist signup.
# 1. Get an API key at https://resend.com/api-keys (re_...)
# 2. Add and verify your sending domain at https://resend.com/domains
# 3. Set RESEND_FROM_EMAIL to a sender on the verified domain.
# If either is unset, signups still work — they just don't get an email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Moveasy <hello@moveasy.africa>"

# Admin dashboard (/admin) -------------------------------------------------------
# Single-admin password gate. Without these, the admin route returns 503.
#   - ADMIN_PASSWORD: the password you'll type at /admin/login
#   - ADMIN_SESSION_SECRET: a long random string used to sign the session
#     cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
